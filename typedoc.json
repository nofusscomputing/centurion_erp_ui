{
    "categorizeByGroup": false,
    "categoryOrder": [
        "Layout",
        "Component",
        "Context",
        "Hook",
        "Backend",
        "*"
    ],
    "cleanOutputDir": true,
    "defaultCategory": "Other",
    "groupReferencesByType": false,
    "extends": [
        "./typedoc.base.json"
    ],
    "disableSources": true,
    "entryPointStrategy": "expand",
    "entryPoints": [
        "src/*.ts",
        "src/*.tsx",
        "src/**/*.ts",
        "src/**/*.tsx",
        "types/*"
    ],
    "excludeExternals": true,
    "excludePrivate": false,
    "externalSymbolLinkMappings": {
        "typescript": {
            "AbortSignal": "https://developer.mozilla.org/en-US/docs/Web/API/AbortSignal",
            "BodyInit": "https://developer.mozilla.org/en-US/docs/Web/API/RequestInit#body",
            "HeadersInit": "https://developer.mozilla.org/en-US/docs/Web/API/RequestInit#headers",
            "Promise": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Promise",
            "Response": "https://developer.mozilla.org/en-US/docs/Web/API/Response"
        },
        "@patternfly/react-core": {
            "EmptyStateStatus": "https://www.patternfly.org/components/empty-state#emptystate",
            "EmptyStateStatus.danger": "https://www.patternfly.org/components/empty-state#emptystate",
            "EmptyStateStatus.warning": "https://www.patternfly.org/components/empty-state#emptystate"
        },
        "react-router": {
            "ErrorBoundary": "https://reactrouter.com/7.18.2/how-to/error-boundary",
            "RouterContextProvider": "https://reactrouter.com/7.18.2/api/utils/RouterContextProvider",
            "RouteObject": "https://reactrouter.com/7.18.2/start/data/route-object",
        }
    },
    "hideGenerator": true,
    "navigation": {
        "includeCategories": true,
        "includeGroups": false,
        "includeFolders": false,
        "compactFolders": false,
        "excludeReferences": false
    },
    "readme": "none",
    "router": "structure-dir",
    "sidebarLinks": {
        "Centurion UI Docs": "/projects/centurion_user_interface/"
    },
    "titleLink": "/projects/centurion_user_interface/",
    "tsconfig": "./tsconfig.json",
    "out": "build/projects/centurion_user_interface/api",
    "plugin": [
        "typedoc-plugin-merge-modules"
    ],
    "mergeModulesRenameDefaults": true,
    "mergeModulesMergeMode": "project",
}